{
  "name": "chen-draw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Excalidraw build that introspects a database and draws its ER diagram in Chen notation.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "sample-db": "node scripts/make-sample-sqlite.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "optionalDependencies": {
    "mssql": "^11.0.1",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
